# Copy this file to .env and fill in your values. Never put real values in this file.

# Supabase > Connect > Session pooler. Change the start to postgresql+asyncpg://
# If your password contains @, write it as %40 (e.g. Pass@1 -> Pass%401).
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# https://<project-id>.supabase.co
SUPABASE_URL=https://<ref>.supabase.co
# Only needed if the project still signs tokens with the legacy shared secret
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

CORS_ORIGINS=http://localhost:8081
